extends ../layout


        
block content

    h2 
        span #{title} 
        a(href="/admin/contacts/new" class="btn btn-primary") Ajouter
    hr

    div.clearfix
   
    section
        //pre= contacts
       
        table.table.table-striped
            thead
                tr.panel.panel-default
                    td
                        +sortBy('Society', 'society')
                    td
                        +sortBy('E-mail', 'email')
                   
                    
                    td= 'Fix'
                    td= 'Mobile'
                    td
                        +sortBy('Fonction', 'fonction')
                    td= 'Métier'
                    td= 'Métier 2'

                    td.text-right 'Actions'
                    
            
            each contact in contacts
                tr
                    td #{contact.society}
                    td #{contact.email}
                    td #{contact.fix}
                    td #{contact.mobile}
                    td #{contact.fonction}
                    td 
                        if contact.metiers.length
                            = contact.metiers[0].title
                    td 
                        if contact.metiers.length
                            = contact.metiers[1].title
                    td.text-right
                        .btn-group
                            a(href="/admin/contacts/edit/"+contact._id class="btn btn-primary") Edit
                            a(href="/admin/contacts/delete/"+contact._id class="btn btn-danger") Delete
                    
                    
        